<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - {{ root_address }}</title>
  
  <!-- Bootstrap CSS + JS (before vis.js) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <!-- vis.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/vis/4.21.0/vis.min.js"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/vis/4.21.0/vis.min.css" rel="stylesheet" type="text/css" />
  
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
      background-color: #f8f9fa;
    }
    
    header {
      background: white;
      padding: 25px 30px;
      border-bottom: 1px solid #e0e0e0;
      flex-shrink: 0;
    }
    
    header h1 {
      font-size: 24px;
      color: #2c3e50;
      margin-bottom: 8px;
      font-weight: 600;
    }
    
    header p {
      color: #555;
      font-size: 13px;
      line-height: 1.6;
      margin: 4px 0;
    }
    
    #network {
      flex: 1 1 auto;
      min-height: 0;
      background-color: #ffffff;
      overflow: hidden;
      position: relative;
    }
  </style>
</head>
<body>
  <!-- Header único -->
  <header>
    <h1>Análisis de Flujos Bitcoin en Ciberdelincuencia</h1>
    <p>Seguimiento de transacciones Bitcoin en casos de Ciberdelincuencia</p>
    <p>Herramientas desarrolladas como parte del TFG - Universidad Internacional de la Rioja (UNIR)</p>
    <p>Grafo de seguimiento de BTCs desde la dirección raíz: <strong>{{ root_address }}</strong></p>
  </header>

  <!-- Grafo a pantalla completa bajo la cabecera (flex:1) -->
  <div id="network"></div>

  <!-- Modal Bootstrap sencillo para detalles -->
  <div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="detailsModalLabel">Detalles</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body" id="detailsModalBody">Cargando...</div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Datos del grafo en fromato JSON
    const rawData = {{ graph_data_json }};
    
    if (!rawData || !rawData.nodes || !rawData.links) {
      console.error('Datos del grafo inválidos:', rawData);
      throw new Error('rawData.nodes o rawData.links no están definidos');
    }
    
    // El nodo root es el que tiene hop=1 y path=0 como source (y nunca aparece como target)
    // Obtenemos todos los target IDs desde los links (Aristas)
    const targetIds = new Set(rawData.links.map(link => link.target));
    // Buscamos el nodo root. Puede ser el source del link con hop=1,path=0, o el que nunca es target
    const rootLink = rawData.links.find(link => (link.hop === 1 || link.hop === 0) && (link.path_id === 0));
    const rootNode = rootLink ? rawData.nodes.find(node => node.id === rootLink.source) : rawData.nodes.find(node => !targetIds.has(node.id));
    
    if (!rootNode) {
      console.error('No se pudo identificar el nodo root');
      throw new Error('No se encontró el nodo root');
    }
    
    // Calcular posiciones basadas en path y hop
    const nodePositions = new Map();
    const pathVerticalOffset = 150; // Espacio reducido entre paths
    const hopHorizontalOffset = 320; // Espacio entre hops
    
    // Root node en posición 0,0
    nodePositions.set(rootNode.id, { x: 0, y: 0 });
    
    // Calcular posición de cada nodo basándose en los links
    rawData.links.forEach(link => {
      // Usar directamente los atributos path_id y hop
      const path = link.path_id || 0;
      const hop = link.hop || 1;
      const x = hop * hopHorizontalOffset;
      const y = path * pathVerticalOffset;
      nodePositions.set(link.target, { x, y });
    });
    
    // Precalcular conjunto de nodos finales (los que no tienen salidas)
    // Set crear un conjunto sin repetidos de IDs que son origen de las aristas (source)
    const sourceIds = new Set(rawData.links.map(link => link.source));
    // Los nodos finales son los que no están en sourceIds
    const finalNodeIds = new Set(rawData.nodes.filter(node => !sourceIds.has(node.id)).map(n => n.id));

    // Preparar nodos con posiciones fijas y colores por rol
    const nodes = new vis.DataSet(
      rawData.nodes.map((node, index) => {
        const isRoot = node.id === rootNode.id;
        const isFinal = finalNodeIds.has(node.id);
        // Azul para el inicialmente, rojo para finales, verde para intermedios.
        const nodeColor = isRoot ? '#1976d2' : (isFinal ? '#d32f2f' : '#2e7d32');
        
        // Obtener posición precalculada si ninguna, usar 0,0
        const pos = nodePositions.get(node.id) || { x: 0, y: 0 };
        

        return {
          id: node.id,
          label: node.label,
          title: `Address: ${node.address}\nHops: ${rawData.links.filter(l => l.source === node.id || l.target === node.id).length}`,
          color: {
            background: nodeColor,
            border: '#333',
            highlight: { background: nodeColor, border: '#FF520F' }
          },
          font: { size: 26, color: '#fff', bold: isRoot },
          shape: 'box',
          x: pos.x,
          y: pos.y,
          nodeIndex: index, // Guardar índice para recuperar nodo original
          //fixed: true
        };
      })
    );
    
    // Segun el valor BTC movidos, el grosor la arista será mayor o menor
    // Calcular rango de valores BTC para normalizar grosor
    // Recuperamos todos los valores BTC
    const btcValues = rawData.links.map(link => link.value_btc || 0);
    // Obtener el valor máximo de BTC
    // ... sirve para hacer spread del array de valores y pasar una lista de argumentos a Math.max
    const maxBtc = Math.max(...btcValues);
    
    // Preparar aristas
    const edges = new vis.DataSet(
      rawData.links.map((link, index) => {
        // Normalizar grosor: mapear valor BTC a rango 1-5
        // valor fijo de 2 si maxBtc es 0 (evitar NaN)
        const normalizedWidth = maxBtc > 0 
          ? 1 + (link.value_btc / maxBtc) * 4 
          : 2;
        
        // Construir label con BTC redondeado a 4 decimales
        const btcLabel = link.value_btc.toFixed(4);
        // Titulo a mostrar sobre las aristas
        const displayLabel = `${btcLabel} BTC\n(path: ${link.path_id}, hop: ${link.hop})`;
        
        return {
          from: link.source,
          to: link.target,
          label: displayLabel,
          title: `BTC: ${link.value_btc.toFixed(8)}\nTxID: ${link.txid}`,
          color: link.follow ? '#333' : '#ccc',
          dashes: !link.follow, // Si es final muestra el trazo punteado, si no es final línea continua
          width: normalizedWidth, // grosor
          arrows: 'to', // flecha en dirección al target
          font: { size: 20, align: 'horizontal' },
          linkIndex: index // Guardar índice para recuperar link original
        };
      })
    );
    
    // Configuración con posiciones fijas
    const options = {
      physics: { enabled: false }, // Desactivar física para usar posiciones fijas
      interaction: {
        hover: true, // resaltar al pasar el ratón
        dragNodes: true, // permitir arrastrar nodos
        dragView: true // permitir arrastrar vista
      },
      edges: { // suavizar aristas por si hay muchas
        smooth: {
          type: 'cubicBezier',
          roundness: 0.4
        }
      }
    };
    
    // Crear red
    // Obtener contenedor donde renderizar el grafo
    const container = document.getElementById('network');
    // Crear la red vis.js
    const network = new vis.Network(container, { nodes, edges }, options);
    
    // Ajustar vista
    network.fit(); // Ajustar vista para mostrar todo el grafo
    
    // Configurar modal Bootstrap para mostrar detalles al hacer click sobre nodos/aristas
    const detailsModalEl = document.getElementById('detailsModal');
    const detailsModalBody = document.getElementById('detailsModalBody');
    const detailsModal = detailsModalEl ? new bootstrap.Modal(detailsModalEl) : null;
    
    // Click: mostrar detalles en modal (simple)
    network.on('click', function(params) {
      //console.log('Modal Click event:', params);
      //Al hacer click sobre cualquier parte del grafo, si es sobre un nodo nos devuelve params.nodes con el ID del nodo
      // y las arisstas que tocan el nodo en params.edges con los IDs de las aristas
      // Si el params del clcik tiene nodes, es que se hizo click sobre un nodo
      if (params.nodes && params.nodes.length > 0) {
        // Recuperamos el ID del nodo clicado
        const nodeId = params.nodes[0];
        // Recuperar nodo original usando el índice guardado
        const nodeData = nodes.get(nodeId);
        const node = rawData.nodes[nodeData.nodeIndex];
        if (node) {
          // Contar enlaces entrantes y salientes
          const outgoing = rawData.links.filter(l => l.source === node.id);
          const incoming = rawData.links.filter(l => l.target === node.id);
          // Construir HTML con detalles del nodo que mostrar en el modal
          const html = `
            <div class="mb-2"><strong>${node.label}</strong></div>
            <div><strong>Address:</strong> ${node.address}</div>
            <div><strong>Wallet ID:</strong> ${node.wallet_explorer_id}</div>
            <div><strong>Classification:</strong> ${node.wallet_classification}</div>
            <div><strong>Label:</strong> ${node.wallet_label}</div>
            <div><strong>Confidence:</strong> ${(node.confidence * 100).toFixed(0)}%</div>
            <div><strong>Description:</strong> ${node.description || ''}</div>
            <div><strong>Outgoing links:</strong> ${outgoing.length}</div>
            <div><strong>Incoming links:</strong> ${incoming.length}</div>`;
          // Mostrar en modal
          if (detailsModal) {
            detailsModalBody.innerHTML = html;
            detailsModal.show();
          }
        }
        return;
      }
      // Si se hace click sobre una arista solo hay params.edges con IDs de las aristas
      if (params.edges && params.edges.length > 0) {
        const edgeId = params.edges[0];
        // Obtener la arista desde el DataSet de vis.js
        const edgeData = edges.get(edgeId);
        // Recuperar link original usando el índice guardado
        const link = rawData.links[edgeData.linkIndex];
        
        if (link && detailsModal) {
          const html = `
            <div class="mb-2"><strong>Transacción</strong></div>
            <div><strong>From:</strong> ${link.source}</div>
            <div><strong>To:</strong> ${link.target}</div>
            <div><strong>BTC:</strong> ${link.value_btc.toFixed(8)}</div>
            <div><strong>Path:</strong> ${link.path_id}</div>
            <div><strong>Hop:</strong> ${link.hop}</div>
            <div><strong>TxID:</strong> ${link.txid}</div>
            <div><strong>Fecha:</strong> ${link.datetime}</div>
            <div><strong>Follow:</strong> <span style="color: ${link.follow ? 'green' : 'red'}">${link.follow ? '✓ Sí' : '✗ No'}</span></div>
            <div><strong>BTC no seguidos:</strong> ${link.btc_not_followed?.toFixed ? link.btc_not_followed.toFixed(8) : link.btc_not_followed || 0}</div>
            <div><strong>BTC consolidados (externos):</strong> ${link.btc_added_from_others?.toFixed ? link.btc_added_from_others.toFixed(8) : link.btc_added_from_others || 0}</div>
            <div><strong>Notas:</strong> ${link.notes || '(ninguna)'}</div>`;
          detailsModalBody.innerHTML = html;
          detailsModal.show();
        }
        return;
      }
      // Clic en vacío: no hacemos nada
    });
  </script>
</body>
</html>
